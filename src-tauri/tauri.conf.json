{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Track Mirror",
  "version": "0.1.0",
  "identifier": "io.github.aaronfeldman.trackmirror",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Track Mirror",
        "width": 860,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["trackmirror"],
          "appLink": false
        }
      ]
    }
  }
}
